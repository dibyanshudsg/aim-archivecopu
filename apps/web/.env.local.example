# Current runtime database: Turso/libSQL
DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here

# Admin auth
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional; defaults to ADMIN_PASSWORD if omitted. Set this to rotate sessions
# independently from the login password. Changing it invalidates existing sessions
# and replacement-upload tickets. Existing installation: leave unchanged until authorized.
# New installation: provision an independent random secret privately.
ADMIN_SESSION_SECRET=

# Cloudflare R2 (object storage for PDFs + cover thumbnails)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=aim-archive
# Operational fallback: 1 stops new PDF grants/admin streams; keep old origins private.
PDF_DELIVERY_DISABLED=0
# Stored catalogue locator namespace; retain even after its public access is disabled.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Optional comma-separated previous public asset bases during an origin change.
# This only maps URLs; it does not migrate objects or make PDFs private.
R2_LEGACY_PUBLIC_BASE_URLS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional anonymous metrics, enabled at build time; not error monitoring.
NEXT_PUBLIC_ENABLE_WEB_VITALS=false

# Manual Admin-to-GitHub worker connection (server-side secret).
# Configure privately on the deployed web host; leave empty until configured.
INDEXING_GITHUB_TOKEN=

# Optional worker cache path; use a writable directory on the worker host.
# INDEXING_OCR_CACHE_PATH=/var/cache/aim-archive
# Optional isolated build directory, e.g. .next-verify. Use .next-* for Turbo outputs.
# NEXT_DIST_DIR=.next-verify
# Local dev defaults to no worker. Opt in only when deliberate.
INDEXING_LOCAL_WORKER=0

# GitHub Actions uses separate encrypted repository secrets named
# INDEXING_TURSO_DATABASE_URL and INDEXING_TURSO_AUTH_TOKEN, plus bucket-scoped
# INDEXING_R2_ACCOUNT_ID, INDEXING_R2_BUCKET, INDEXING_R2_ACCESS_KEY_ID,
# INDEXING_R2_SECRET_ACCESS_KEY. Workflow maps these to runtime TURSO_* and R2_*.
# See TECHNICAL_SPECIFICATION.md and GITHUB_INDEXING.md at the repo root.
