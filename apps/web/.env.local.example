# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Turso/libSQL (target database after Supabase migration)
DATABASE_PROVIDER=supabase
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here

# Admin auth
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional; defaults to ADMIN_PASSWORD if omitted. Set this to rotate sessions
# independently from the login password.
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret

# Cloudflare R2 (object storage for PDFs + cover thumbnails)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=aim-archive
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
