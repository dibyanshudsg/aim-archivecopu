{
  "name": "aim-archive",
  "private": true,
  "scripts": {
    "verify:runtime": "node scripts/verify-runtime-setup.cjs",
    "verify:admin-release": "node scripts/verify-admin-release-env.cjs",
    "test:environment": "node scripts/test-runtime-environment.cjs",
    "test:migrations": "node scripts/test-turso-migrations.mjs",
    "test:rate-limits": "node scripts/test-rate-limits.cjs",
    "test:pdf-security": "node scripts/test-pdf-security.cjs",
    "test:review": "node scripts/test-review.cjs",
    "test:indexing": "node scripts/test-indexing.cjs",
    "test:indexing-jobs": "node scripts/test-indexing-jobs.cjs",
    "indexing:worker": "node scripts/indexing-worker.cjs",
    "test:search-extraction": "node scripts/test-search-extraction.cjs",
    "dev": "turbo dev",
    "dev:local-db": "node scripts/dev-local-db.mjs",
    "dev:prewarm": "node scripts/prewarm-local.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "migration:apply:turso": "node scripts/apply-turso-migrations.mjs",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "2.9.14"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "10.33.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "tesseract.js"
    ],
    "overrides": {
      "@types/react": "^19.1.2",
      "@types/react-dom": "^19.1.2",
      "postcss@>=8 <8.5.23": "8.5.23",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@>=1 <1.2.2": "1.2.2"
    }
  }
}
