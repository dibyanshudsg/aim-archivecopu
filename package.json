{
  "name": "aim-archive",
  "private": true,
  "scripts": {
    "test:review": "node scripts/test-review.cjs",
    "test:indexing": "node scripts/test-indexing.cjs",
    "test:indexing-jobs": "node scripts/test-indexing-jobs.cjs",
    "indexing:worker": "node scripts/indexing-worker.cjs",
    "test:search-extraction": "node scripts/test-search-extraction.cjs",
    "dev": "turbo dev",
    "dev:local-db": "node scripts/dev-local-db.mjs",
    "dev:prewarm": "node scripts/prewarm-local.mjs",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "migration:apply:turso": "node scripts/apply-turso-migrations.mjs",
    "migration:export:supabase": "node scripts/export-supabase-data.mjs",
    "migration:import:turso": "node scripts/import-turso-data.mjs",
    "migration:verify:turso": "node scripts/verify-migrated-data.mjs",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "tesseract.js"
    ],
    "overrides": {
      "@types/react": "^19.1.2",
      "@types/react-dom": "^19.1.2"
    }
  }
}
